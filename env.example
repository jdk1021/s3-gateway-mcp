# Copy to .env and fill in:  cp env.example .env

# --- MCP server
# Bearer token for HTTP mode. Generate: openssl rand -hex 32
MCP_TOKEN=
# MCP_AUTH_DISABLED=false

# --- S3 connection
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Defaults
S3_BUCKET=static

# --- Optional
# Public URLs are built from S3_ENDPOINT. Set this only for a CDN or custom domain.
# Use {bucket} to cover every bucket: https://cdn.example.com/{bucket}
# S3_PUBLIC_URL=https://cdn.example.com/static
# S3_PATH_PREFIX=uploads/
# S3_ALLOWED_BUCKETS=static,projects

# --- Safety
S3_READ_ONLY=false
S3_ALLOW_DESTRUCTIVE=true

# --- Local files (colon-separated absolute paths)
# upload_file can publish ANY readable file here. Keep it narrow; avoid $HOME.
ALLOWED_DIRS=/tmp
# DOWNLOAD_DIR=/home/you/Downloads/s3
MAX_UPLOAD_MB=100
MAX_INLINE_KB=1024
